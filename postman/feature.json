    },
    {
      "name": "8. Delete own comment",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:8080/users/{{userId}}/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Create comment for admin delete",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"text\": \"Комментарий для администратора\"\n}"
        },
        "url": "http://localhost:8080/users/{{userId}}/comments/events/{{eventId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.collectionVariables.set(\"adminCommentId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Admin delete comment",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:8080/admin/comments/{{adminCommentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
