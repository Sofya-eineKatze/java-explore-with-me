              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Get user comments",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/users/{{userId}}/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Get comment by id",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/users/{{userId}}/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
